<Page
    x:Class="RtxAutoCurveOptimizer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="720"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsDemoHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsDemoDescription" Style="{StaticResource SecondaryTextStyle}" />
                    <ToggleSwitch x:Name="DemoSwitch" x:Uid="SettingsDemoSwitch" Toggled="DemoSwitch_Toggled" />
                    <InfoBar
                        x:Name="BusyBar"
                        x:Uid="SettingsBusyBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Warning" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="SettingsAboutHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="SessionsText" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="ProfilesText" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
