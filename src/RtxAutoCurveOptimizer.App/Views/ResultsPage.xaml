<Page
    x:Class="RtxAutoCurveOptimizer.App.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RtxAutoCurveOptimizer.App.Controls"
    xmlns:vm="using:RtxAutoCurveOptimizer.App.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel>
                <TextBlock x:Uid="ResultsTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" />
            </StackPanel>

            <!-- Empty state -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="ResultsEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="ResultsEmptyText" Style="{StaticResource SecondaryTextStyle}" />
                    <Button x:Uid="ResultsGoOptimize" Click="GoOptimize_Click" />
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

            <InfoBar
                x:Uid="ResultsNotElevatedBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NotElevated, Mode=OneWay}"
                Severity="Informational" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                <!-- Proposals -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ResultsProposalsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView
                        ItemsSource="{x:Bind ViewModel.Cards}"
                        SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}"
                        SelectionMode="Single">
                        <GridView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProposalCard">
                                <Grid
                                    Width="288"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}" />
                                        <Border
                                            Padding="8,2"
                                            HorizontalAlignment="Right"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Visibility="{x:Bind IsRecommended}">
                                            <TextBlock
                                                x:Uid="ResultsRecommendedBadge"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind CapText}" />
                                    <Grid Grid.Row="2" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Uid="ResultsCardPower" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind PowerText}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind PowerDeltaText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Uid="ResultsCardPerformance" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind PerformanceText}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xE73E;"
                                            Visibility="{x:Bind IsValidated}" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE7BA;"
                                            Visibility="{x:Bind IsPending}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind ValidationText}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind MarginText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider
                        x:Uid="ResultsShift"
                        LargeChange="30"
                        Maximum="{x:Bind ViewModel.MaxShiftMhz, Mode=OneWay}"
                        Minimum="-150"
                        SmallChange="15"
                        StepFrequency="15"
                        Value="{x:Bind ViewModel.ShiftMhz, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ShiftText, Mode=OneWay}" />
                    <Slider
                        x:Uid="ResultsClockLimit"
                        Grid.Column="2"
                        LargeChange="30"
                        Maximum="{x:Bind ViewModel.PeakClockMhz, Mode=OneWay}"
                        Minimum="{x:Bind ViewModel.MinClockMhz, Mode=OneWay}"
                        SmallChange="15"
                        StepFrequency="15"
                        Value="{x:Bind ViewModel.ClockLimitMhz, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,0,8"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ClockLimitText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="ResultsShiftHint"
                        Grid.Row="2"
                        Grid.ColumnSpan="4"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="ResultsApply"
                        Command="{x:Bind ViewModel.ApplyCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Uid="ResultsValidate" Command="{x:Bind ViewModel.ValidateCommand}" />
                    <Button x:Uid="ResultsSave" Command="{x:Bind ViewModel.SaveCommand}" />
                    <DropDownButton x:Uid="ResultsExport">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem x:Uid="ResultsExportJson" Command="{x:Bind ViewModel.ExportJsonCommand}" />
                                <MenuFlyoutItem x:Uid="ResultsExportCsv" Command="{x:Bind ViewModel.ExportCsvCommand}" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Uid="ResultsRestore" Command="{x:Bind ViewModel.RestoreCommand}" />
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.IsValidating, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            Width="24"
                            Height="24"
                            IsActive="{x:Bind ViewModel.IsValidating, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Uid="ResultsValidatingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.OperationText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            x:Uid="ResultsCancelValidation"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.CancelValidationCommand}" />
                    </Grid>
                </Border>

                <!-- Chart -->
                <Border Height="380" Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="ResultsChartTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <controls:CurveChart
                            Grid.Row="1"
                            PlotClicked="Chart_PlotClicked"
                            Series="{x:Bind ViewModel.Series, Mode=OneWay}"
                            XMax="{x:Bind ViewModel.ChartXMax, Mode=OneWay}"
                            XMin="{x:Bind ViewModel.ChartXMin, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Anchor table -->
                <Border Padding="0,12,0,8" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="ResultsAnchorsHeader"
                            Margin="16,0,16,4"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid Margin="16,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="ResultsColVoltage" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColStock" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColMaxStable" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColRecommended" Grid.Column="3" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColPower" Grid.Column="4" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColPerformance" Grid.Column="5" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColPerfPerWatt" Grid.Column="6" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:Uid="ResultsColNote" Grid.Column="7" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Anchors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnchorRow">
                                    <Grid Margin="0" Padding="16,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Voltage}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Stock}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind MaxStable}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Recommended}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Power}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind Performance}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind PerfPerWatt}" />
                                        <TextBlock
                                            Grid.Column="7"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Note}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
